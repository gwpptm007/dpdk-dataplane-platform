+/**
+ * 私有标识只支持本地 TAP 的单个 DROP 或 QUEUE 动作
+ * 先检查完整动作列表，禁止远端复制、共享 RSS 动作和缺失标识的降级
+ * validate 与 create 共用这里，任何内核写入发生前都必须通过检查
+ */
+static int
+tap_owner_validate(struct pmd_internals *pmd,
+		   const struct rte_flow_attr *attr,
+		   const struct rte_flow_action actions[],
+		   struct rte_flow_error *error, struct rte_flow *flow,
+		   int mirred)
+{
+	const struct dppd_tap_owner_action *owner = NULL;
+	const struct rte_flow_action *entry;
+	unsigned int markers = 0, fates = 0, unsupported = 0;
+
+	for (entry = actions; entry->type != RTE_FLOW_ACTION_TYPE_END; ++entry) {
+		if ((int)entry->type == DPPD_TAP_ACTION_OWNER_V1) {
+			markers++;
+			owner = entry->conf;
+		} else if (entry->type == RTE_FLOW_ACTION_TYPE_DROP ||
+			   entry->type == RTE_FLOW_ACTION_TYPE_QUEUE) {
+			fates++;
+		} else if (entry->type != RTE_FLOW_ACTION_TYPE_VOID) {
+			unsupported++;
+		}
+	}
+	if (markers == 0)
+		return 0;
+	if (markers != 1 || owner == NULL || owner->version != 1 ||
+	    owner->size != sizeof(*owner) ||
+	    !dppd_tap_cookie_present(owner->cookie))
+		return rte_flow_error_set(error, EINVAL, RTE_FLOW_ERROR_TYPE_ACTION_CONF,
+				  actions, "invalid DPPD TAP owner action");
+	if (!attr->ingress || attr->egress || attr->transfer ||
+	    pmd->remote_if_index != 0 || mirred != 0 ||
+	    fates != 1 || unsupported != 0)
+		return rte_flow_error_set(error, ENOTSUP, RTE_FLOW_ERROR_TYPE_ACTION,
+				  actions, "DPPD owner requires local ingress DROP or QUEUE");
+	if (flow != NULL)
+		memcpy(flow->owner_cookie, owner->cookie, sizeof(flow->owner_cookie));
+	return 0;
+}
