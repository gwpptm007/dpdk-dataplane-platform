  "activations": [
    {
      "participant": "pmd",
      "from": 315,
      "to": 520,
      "type": "backend"
    },
    {
      "participant": "nic",
      "from": 250,
      "to": 295,
      "type": "external"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "读图前提",
      "items": [
        "按 DPDK v24.11 ixgbe_recv_pkts 的单段成功路径推演，省略同批其他包",
        "泳道中的主机内存是访问目标，不是独立执行线程",
        "A 与 B 是不同 mbuf；数据没有从 A 复制到 B"
      ]
    },
    {
      "dot": "amber",
      "title": "图中不能省略的条件",
      "items": [
        "分配 B 失败：停在当前完成描述符，保留 A，下一次再尝试",
        "描述符写好不等于立即可用；RDT 发布受累计阈值和尾边界约束",
        "默认普通直接 mbuf 且引用计数为 1，释放 A 才归还池；缓存可能暂存归还对象"
      ]
    },
    {
      "dot": "slate",
      "title": "证据与适用范围",
      "items": [
        "源码：DPDK v24.11 / ixgbe_rxtx.c:1683–1873",
        "此图解释驱动机制，不代表本项目已经使用 ixgbe 硬件完成测量",
        "其他 PMD、向量路径、分段接收及 net_ring 不应照搬此时序"
      ]
    }
  ]
